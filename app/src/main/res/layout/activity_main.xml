<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/triki_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title=""
            app:menu="@menu/main_menu"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Big Centered Header / Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="42sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/triki_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle_app"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/triki_text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Accessibility Warning Banner -->
            <TextView
                android:id="@+id/textAccessibilityWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="14dp"
                android:background="@color/warning_bg"
                android:textColor="@color/warning_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/accessibility_not_enabled"
                android:visibility="gone" />

            <!-- Card 1: Connection & Status Hub -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/triki_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/triki_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/stat_sys_data_bluetooth"
                            app:tint="@color/triki_primary"
                            android:contentDescription="@string/label_status" />

                        <TextView
                            android:id="@+id/textStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/triki_text"
                            android:text="@string/status_disconnected" />

                        <TextView
                            android:id="@+id/textBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/triki_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnConnect"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/btn_connect" />

                        <Button
                            android:id="@+id/btnDisconnect"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            style="?attr/materialButtonOutlinedStyle"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/btn_disconnect" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Live IMU Motion Monitor -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/triki_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/triki_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/triki_text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:text="@string/title_motion_monitor" />

                    <TextView
                        android:id="@+id/textMotionState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:padding="16dp"
                        android:background="@color/motion_idle_bg"
                        android:textColor="@color/motion_idle_text"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="@string/motion_idle" />

                    <TextView
                        android:id="@+id/textImuValues"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/triki_text_secondary"
                        android:text="Rotation (Gz): 0.0 deg/s | Shake: 0.0" />

                    <TextView
                        android:id="@+id/textLastGesture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/triki_text"
                        android:text="@string/label_last_gesture" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Quick Setup Shortcuts Hub -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/triki_surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/triki_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/triki_text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:text="@string/label_quick_start" />

                    <Button
                        android:id="@+id/btnHomeGrantPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/btn_grant_permissions" />

                    <Button
                        android:id="@+id/btnHomeAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        style="?attr/materialButtonOutlinedStyle"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/btn_accessibility" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Version Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/triki_text_secondary"
                android:text="TrikiTok v2.0" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
